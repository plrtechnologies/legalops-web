
PORT=3001

 # Base URL of backend API – do not add `/session/` here
REACT_APP_API_BASE_URL=http://localhost:3000/api

# Session API endpoint (relative path)
REACT_APP_API_SESSION=/session/create-session
REACT_APP_API_LOGIN=/auth/login
REACT_APP_API_SIGNUP=/auth/signup

# Optional: fallback plain backend URL if needed elsewhere
REACT_APP_API_URL=http://localhost:3000

